# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_NAME=alerta-cuenta
APP_SECRET=replace_with_generated_secret

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# NUNCA poner esta clave en frontend
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Supabase ──────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY nunca debe estar en frontend
SUPABASE_URL=replace_with_supabase_project_url
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_DB_URL=replace_with_supabase_database_url
SUPABASE_STORAGE_BUCKET=evidence

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── Email ─────────────────────────────────────────────────────────────────────
# En local usar "console" para imprimir en terminal en vez de enviar
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
